PORT=3000
NRP_API_KEY=your_nrp_api_token_here
NRP_BASE_URL=https://ellm.nrp-nautilus.io/v1
NRP_MODEL=gpt-oss

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: a private base64-encoded random value (at least 32 random bytes)
# isolates NRP prompt caches. If omitted, the server generates one on startup.
NRP_CACHE_SALT=

# --- Optional ---
NODE_ENV=
TRUST_PROXY_HOPS=
CHAT_RATE_LIMIT=30
EXPLAIN_RATE_LIMIT=30
LESSON_RATE_LIMIT=120
CSP_REPORT_ONLY=
