PORT=3000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Optional ---
# Set to production on your deployed host (turns on upgrade-insecure-requests in the CSP).
NODE_ENV=
# Set to 1 when deployed behind a host's proxy (Render, Railway, Fly, ...)
# so rate limiting sees each visitor's real IP. Leave unset for local development.
TRUST_PROXY_HOPS=
# Requests per minute per IP.
CHAT_RATE_LIMIT=30
EXPLAIN_RATE_LIMIT=30
LESSON_RATE_LIMIT=120
# Moderation model (default: omni-moderation-latest)
OPENAI_MODERATION_MODEL=
# Set to true to REPORT Content-Security-Policy violations in the browser console
# without blocking anything. Try this first, then remove it to enforce.
CSP_REPORT_ONLY=